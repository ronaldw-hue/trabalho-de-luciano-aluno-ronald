{
  "name": "guia-turistico-curitiba",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm:css:watch\" \"npm:web\"",
    "css:watch": "tailwindcss -i ./src/input.css -o ./src/output.css --watch",
    "css:build": "tailwindcss -i ./src/input.css -o ./src/output.css --minify",
    "web": "vite --host 0.0.0.0",
    "build": "npm run css:build && vite build && cp ./src/script.js ./dist/script.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0"
  }
}